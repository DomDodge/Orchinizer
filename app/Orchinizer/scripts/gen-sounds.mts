// Synthesizes the phone-side Preview sounds into assets/sounds/*.wav and writes src/sounds.gen.ts.
// Tonal instruments get semitones 0..18 above C (covers every key the server deals: C G D A F,
// times the pentatonic rows). Drums get kick/snare/hat. Run: npm run sounds
import { mkdirSync, writeFileSync } from 'node:fs';

const SR = 22050;
const TAU = Math.PI * 2;
const SEMITONES = 19;
const hz = (midi: number) => 440 * 2 ** ((midi - 69) / 12);

let seed = 1;
const noise = () => (seed = (seed * 16807) % 2147483647) / 1073741823.5 - 1;
const atk = (t: number, a: number) => Math.min(1, t / a);
const saw = (x: number) => 2 * (x - Math.floor(x)) - 1;

function render(dur: number, fn: (t: number) => number) {
  const out = new Float32Array(Math.floor(SR * dur));
  for (let i = 0; i < out.length; i++) out[i] = fn(i / SR);
  return out;
}

/** Saw through a one-pole low-pass whose cutoff follows `cut(t)` (0..1). */
function filteredSaw(dur: number, freqs: number[], cut: (t: number) => number, amp: (t: number) => number) {
  let lp = 0;
  return render(dur, (t) => {
    const x = freqs.reduce((s, f) => s + saw(f * t), 0) / freqs.length;
    lp += (x - lp) * cut(t);
    return lp * amp(t);
  });
}

const tonal: Record<string, (f: number) => Float32Array> = {
  // C3 upward: phone speakers can't do real sub bass, so lean on harmonics.
  bass: (f) => filteredSaw(0.5, [f], (t) => 0.08 + 0.3 * Math.exp(-t * 12), (t) => atk(t, 0.005) * Math.exp(-t * 4)),
  pad: (f) => filteredSaw(1.0, [f * 0.995, f, f * 1.005], () => 0.12, (t) => atk(t, 0.12) * Math.min(1, (1 - t) * 3)),
  lead: (f) => render(0.45, (t) => atk(t, 0.003) * Math.exp(-t * 6) * (Math.sign(Math.sin(TAU * f * t)) * 0.6 + Math.sin(TAU * f * 2 * t) * 0.4)),
};
const octave: Record<string, number> = { bass: 48, pad: 60, lead: 72 };

let prev = 0;
const hp = () => { const n = noise(); const o = n - prev; prev = n; return o * 0.5; };
const drums = [
  render(0.4, (t) => Math.sin(TAU * (45 * t + (105 * (1 - Math.exp(-25 * t))) / 25)) * Math.exp(-t * 7)),
  render(0.25, (t) => noise() * Math.exp(-t * 20) * 0.7 + Math.sin(TAU * 190 * t) * Math.exp(-t * 25) * 0.5),
  render(0.08, (t) => hp() * Math.exp(-t * 50)),
];

function wav(s: Float32Array) {
  const peak = s.reduce((m, v) => Math.max(m, Math.abs(v)), 0) || 1;
  const fadeN = Math.floor(SR * 0.02);
  const b = Buffer.alloc(44 + s.length * 2);
  b.write('RIFF', 0); b.writeUInt32LE(36 + s.length * 2, 4); b.write('WAVE', 8);
  b.write('fmt ', 12); b.writeUInt32LE(16, 16); b.writeUInt16LE(1, 20); b.writeUInt16LE(1, 22);
  b.writeUInt32LE(SR, 24); b.writeUInt32LE(SR * 2, 28); b.writeUInt16LE(2, 32); b.writeUInt16LE(16, 34);
  b.write('data', 36); b.writeUInt32LE(s.length * 2, 40);
  s.forEach((v, i) => b.writeInt16LE(Math.round((v / peak) * 0.9 * Math.min(1, (s.length - i) / fadeN) * 32767), 44 + i * 2));
  return b;
}

const dir = new URL('../assets/sounds/', import.meta.url);
mkdirSync(dir, { recursive: true });
const lines: string[] = [];
const out = (name: string, s: Float32Array) => {
  writeFileSync(new URL(`${name}.wav`, dir), wav(s));
  return `require('../assets/sounds/${name}.wav')`;
};
for (const [inst, synth] of Object.entries(tonal)) {
  const reqs = Array.from({ length: SEMITONES }, (_, s) => out(`${inst}_${s}`, synth(hz(octave[inst] + s))));
  lines.push(`  ${inst}: [${reqs.join(', ')}],`);
}
lines.push(`  drums: [${drums.map((s, i) => out(`drums_${i}`, s)).join(', ')}],`);
writeFileSync(
  new URL('../src/sounds.gen.ts', import.meta.url),
  `// Generated by scripts/gen-sounds.ts — do not edit.\n// Tonal: index = semitones above C. Drums: kick, snare, hat.\nexport const SOUNDS: Record<string, number[]> = {\n${lines.join('\n')}\n};\n`,
);
console.log('sounds written');
